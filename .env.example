# Copy this file to .env. Never commit real secrets.

# Generate a strong value before staging or production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me-in-prod
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=1440

# AWS / DynamoDB. For local development, either set these here or use the
# standard AWS chain: AWS env vars, ~/.aws/credentials, or an instance role.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: set this only when using DynamoDB Local.
# Example: http://localhost:8001
DYNAMODB_ENDPOINT_URL=

# Comma-separated frontend origins. Add the Vercel URL in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174

# Groq powers the v0 resident chat, profile extraction, and ops assistant.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Resident OTP dev mode returns/logs the code instead of sending SMS.
# Turn false after wiring a real SMS/WhatsApp provider.
OTP_DEV_MODE=true
