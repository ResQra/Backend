# Copy this file to .env. Never commit real secrets.

# Generate a strong value before staging or production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me-in-prod
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=1440

# AWS / DynamoDB. For local development, either set these here or use the
# standard AWS chain: AWS env vars, ~/.aws/credentials, or an instance role.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: set this only when using DynamoDB Local.
# Example: http://localhost:8001
DYNAMODB_ENDPOINT_URL=

# Comma-separated frontend origins. Add the Vercel URL in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174

# Groq powers the v0 resident chat, profile extraction, and ops assistant.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini powers coordinator voice notes, photo understanding, and spoken
# replies (Phase 6). Empty = those endpoints answer 503; text chat unaffected.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Duplex live voice (Gemini Live API). First choice; the proxy falls through
# to known-good models if Google retires the ID.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# Strands agent runtime (arch §46/§77). Empty = local agents/ in dev.
RESQRA_AGENT_URL=
RESQRA_AGENTS_PATH=

# Amazon Bedrock text provider (optional). Empty = stay on Groq.
# Set a model id (e.g. amazon.nova-lite-v1:0) + real AWS creds above to
# route plain chat completions through Bedrock Converse. Voice always
# stays on Gemini Live; tool-calling (debate) always stays on Groq.
BEDROCK_TEXT_MODEL=
BEDROCK_REGION=us-east-1

# Resident OTP dev mode returns/logs the code instead of sending SMS.
# Turn false after wiring a real SMS/WhatsApp provider.
OTP_DEV_MODE=true
